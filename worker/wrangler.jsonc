// Konfiguration des Push- und Sync-Dienstes (Architektur 8.7)
// Secrets NICHT hier eintragen, sondern mit `npx wrangler secret put …`:
//   VAPID_PRIVATE_KEY, SETUP_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pa-push",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pa-db",
      "database_id": "HIER-DATABASE-ID-EINTRAGEN",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://mistwe-chefe.github.io",
    "VAPID_SUBJECT": "https://mistwe-chefe.github.io/mistwe-mobile/",
    "VAPID_PUBLIC_KEY": "HIER-OEFFENTLICHEN-VAPID-SCHLUESSEL-EINTRAGEN"
  },
  "observability": { "enabled": true }
}
